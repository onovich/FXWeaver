{
  "name": "fxweave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --noEmit && vite build",
    "smoke": "playwright test",
    "smoke:webgl": "playwright test tests/webgl-spike.smoke.spec.ts",
    "spike:capture": "node scripts/capture-phase1-spike.mjs",
    "runtime:capture": "node scripts/capture-phase1-generated.mjs",
    "work03:capture": "playwright test --config=playwright.capture.config.ts tests/work03.capture.spec.ts",
    "demo:capture": "node scripts/capture-phase0-demo.mjs"
  },
  "dependencies": {
    "pixi.js": "8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
